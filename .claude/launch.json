{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "openkoto-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@openkoto/worker",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "openkoto-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@openkoto/web",
        "exec",
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}