{
  "name": "@openkoto/cli",
  "version": "0.1.0",
  "description": "koto — the OpenKoto command line: vocabulary review, lyrics translation and your reading library from the terminal.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "koto": "./dist/koto.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@openkoto/client": "workspace:*",
    "@openkoto/core": "workspace:*",
    "@types/node": "^22.19.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
