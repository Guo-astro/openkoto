    "import.media.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentences are rebuilt from the subtitle timeline, so explanations always get whole sentences instead of subtitle fragments. Without a media file you still get a timed transcript to read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕はタイムラインから文単位で組み直されるため、解説には断片ではなく完全な文が渡ります。メディアを選ばなくても、時間情報付きの文章として読めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕会按时间轴重新拼成完整句子，精讲拿到的是整句而不是字幕碎片。不选媒体文件也可以，那就是一篇带时间轴的文稿。"
          }
        }
      }
    },
    "import.media.footer.asr": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a subtitle file if you have one. Otherwise choose just the media and generate subtitles on device afterwards. Either way, sentences are rebuilt from the timeline so explanations get whole sentences."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕ファイルがあれば選んでください。なければメディアだけ選び、後から端末内の音声認識で字幕を生成できます。どちらの場合もタイムラインから文単位で組み直されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有字幕文件就选上；没有的话只选媒体，进去之后可以用本机语音识别生成字幕。两种方式都会按时间轴重新拼成完整句子，精讲拿到的是整句。"
          }
        }
      }
    },
    "import.media.needSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This system can't generate subtitles on device (needs iOS 26). Pick a subtitle file to save this media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシステムではデバイス上で字幕を生成できません（iOS 26 が必要）。保存するには字幕ファイルを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
