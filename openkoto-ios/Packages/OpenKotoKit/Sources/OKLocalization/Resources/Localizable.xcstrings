    "onboarding.welcome.page1.point1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB and TXT books, split into chapters with your place remembered"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB と TXT の本を自動で章分けし、読んだ位置を記憶"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB 与 TXT 电子书，自动分章、记住读到哪"
          }
        }
      }
    },
    "onboarding.welcome.page1.point2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video and audio with subtitles — no subtitles? Generate them on device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画と音声を字幕付きで。字幕がなければ端末内で生成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频与音频配字幕；没有字幕就用本机语音识别当场生成"
          }
        }
      }
    },
    "onboarding.welcome.page1.point3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share web pages and text into OpenKoto from any app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでもウェブページやテキストを共有"
          }
