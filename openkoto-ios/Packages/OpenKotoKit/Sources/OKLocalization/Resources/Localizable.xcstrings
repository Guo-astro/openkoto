    "paywall.legal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless cancelled at least 24 hours before the end of the period. Manage or cancel them in your Apple ID settings. Purchases are linked to the OpenKoto account you are signed in with."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、期間終了の 24 時間以上前に解約しない限り自動更新されます。Apple ID の設定で管理・解約できます。購入はサインイン中の OpenKoto アカウントに紐付けられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续期，除非在当期结束前至少 24 小时取消。可在 Apple ID 设置中管理或取消。购买会关联到当前登录的 OpenKoto 账号。"
          }
        }
      }
    },
