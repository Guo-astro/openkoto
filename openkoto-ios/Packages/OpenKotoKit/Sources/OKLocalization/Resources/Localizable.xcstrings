        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの応答がタイムアウトしました。再試行するか、より速いモデルに切り替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型响应超时。可以重试，或换一个更快的模型。"
          }
        }
