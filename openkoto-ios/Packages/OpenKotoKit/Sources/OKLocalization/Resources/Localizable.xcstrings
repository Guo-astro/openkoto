    "settings.account.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to sync with OpenKoto Cloud across iPhone, iPad, Mac, the desktop app and the web. Your data on this device stays yours whether or not you sign in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインすると、OpenKoto クラウドで iPhone・iPad・Mac・デスクトップ版・Web 間を同期できます。サインインの有無にかかわらず、このデバイスのデータはそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后可通过 OpenKoto 云在 iPhone、iPad、Mac、桌面端与网页之间同步。无论是否登录，本机数据都完整保留。"
          }
        }
      }
    },
