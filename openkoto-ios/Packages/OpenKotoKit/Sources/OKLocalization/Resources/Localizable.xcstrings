    "settings.sync.footer.icloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words, review progress, explanations, book text, subtitles and highlights sync between your iPhone, iPad and Mac through your own iCloud account. Book and video files stay on each device, so on other devices you can read and study the text but not open the original file. The first sync may take a while."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語・復習の進捗・精読解説・書籍本文・字幕・ハイライトを、ご自身の iCloud アカウント経由で iPhone・iPad・Mac 間で同期します。書籍と動画のファイル自体は各デバイスに残るため、他のデバイスではテキストの学習はできますが原本は開けません。初回の同期には時間がかかることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生词、复习进度、精讲、书籍正文、字幕与划线会经你自己的 iCloud 账号在 iPhone、iPad 与 Mac 之间同步。书籍与视频文件留在各自设备上，所以在别的设备上文本能读能学，但打不开原文件。首次同步可能较久。"
          }
        }
      }
    },
    "settings.sync.footer.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is off. Everything stays on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期はオフです。すべてのデータはこのデバイスにのみ保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已关闭，所有数据只保存在本机。"
          }
        }
      }
    },
    "settings.sync.footer.openkoto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words, review progress, word packs, articles, book text, highlights and reading progress sync through your OpenKoto account, across iPhone, iPad, Mac, the desktop app and the web. Book and video files stay on each device. The first sync may take a while."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語・復習の進捗・単語帳・記事・書籍本文・ハイライト・読書位置を OpenKoto アカウント経由で同期し、iPhone・iPad・Mac・デスクトップ版・Web で共有します。書籍と動画のファイル自体は各デバイスに残ります。初回の同期には時間がかかることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生词、复习进度、词包、文章、书籍正文、划线与阅读进度经你的 OpenKoto 账号同步，iPhone、iPad、Mac、桌面端与网页通用。书籍与视频文件留在各自设备上。首次同步可能较久。"
          }
        }
      }
    },
