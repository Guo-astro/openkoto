          "stringUnit": {
            "state": "translated",
            "value": "从任何 App 把网页和文字分享进来"
          }
        }
      }
    },
    "onboarding.welcome.page1.point4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search every word you have ever read, across the whole library"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ全体を全文検索——読んだ一文をいつでも探せます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个资源库全文搜索，找回读过的任何一句"
          }
        }
      }
    },
    "onboarding.welcome.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read what you actually like"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなものを読む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读你真正喜欢的东西"
          }
        }
      }
    },
    "onboarding.welcome.page2.point1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text is split into sentences automatically — tap one to work on it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文は自動で文単位に分割。タップした文から読み進める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正文自动切成句子，点一句就读一句"
          }
        }
      }
    },
    "onboarding.welcome.page2.point2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Furigana and pinyin generated on device — no network, no cost, nothing uploaded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふりがなとピンインは端末内で生成。通信も費用も不要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "振假名与拼音在本机生成——不联网、不花钱、不上传"
          }
        }
      }
    },
    "onboarding.welcome.page2.point3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between reflowed and original layout; progress and highlights follow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リフローと原本レイアウトを切替可能。進捗もマーカーも共通"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生与原版排版随时切换，进度、书签、划线两边通用"
          }
        }
      }
    },
    "onboarding.welcome.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentence by sentence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一文ずつ読む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一句一句地读"
          }
        }
      }
    },
    "onboarding.welcome.page3.point1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation plus context, grammar and cultural notes for any sentence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文ごとの翻訳に加え、文脈・文法・文化背景も解説"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐句翻译，并讲语境、语法与文化背景"
          }
        }
      }
    },
    "onboarding.welcome.page3.point2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocabulary and grammar points come out structured — save with one tap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語彙と文法事項を構造化して出力、ワンタップで保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生词与语法点结构化输出，一键收藏"
          }
        }
      }
    },
    "onboarding.welcome.page3.point3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just one word? Tap it for a quick definition in context — far cheaper than a full explanation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一語だけ知りたい時はタップ——文脈つきの語義だけを安く引けます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只想知道一个词？点它单查，带上下文的释义，比整句精讲便宜得多"
          }
        }
      }
    },
    "onboarding.welcome.page3.point4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own API key — requests go straight to the provider you choose. We run no server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
