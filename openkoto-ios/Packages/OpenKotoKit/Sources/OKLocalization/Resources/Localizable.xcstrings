    "settings.account.delete.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion is completed on the OpenKoto website. After a 7-day grace period your cloud data is permanently removed. Data on this device is not affected; App Store subscriptions must be cancelled in system Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除は OpenKoto の Web サイトで行います。7 日間の猶予期間のあと、クラウド上のデータは完全に削除されます。このデバイスのデータには影響しません。App Store のサブスクリプションはシステム設定から別途解約してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账号在 OpenKoto 网站上完成，7 天冷静期后云端数据会被永久清除。本机数据不受影响；App Store 订阅需要在系统设置中另行取消。"
          }
        }
      }
    },
    "settings.account.device.current": {
      "extractionState": "manual",
