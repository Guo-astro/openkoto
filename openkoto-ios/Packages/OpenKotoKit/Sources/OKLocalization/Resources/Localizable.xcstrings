    "settings.sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期"
          }
        },
        "zh-Hans": {
          "stringUnit": {
