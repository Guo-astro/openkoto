    "ai.error.insufficientBalance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider account is out of credit. Top up or switch providers — retrying won't help."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーの残高が不足しています。チャージするか別のプロバイダーに切り替えてください。再試行しても解決しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务商账户额度已用尽。请充值或换一个服务商——重试不会有帮助。"
          }
        }
      }
    },
    "ai.error.malformed": {
