      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will fetch the latest data from iCloud once, then upload everything to OpenKoto Cloud and stop using iCloud sync. Nothing is deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは iCloud から最新データを一度取得したあと、すべてを OpenKoto クラウドにアップロードし、以後 iCloud 同期を使用しません。データは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机会先从 iCloud 拉取一次最新数据，再把全部内容上传到 OpenKoto 云，之后不再使用 iCloud 同步。不会删除任何数据。"
          }
