    "batch.scope.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each sentence is one AI request. Already-processed sentences are skipped, and identical text explained elsewhere is reused for free."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 文につき 1 回の AI リクエストです。処理済みの文はスキップされ、他で解説済みの同一文は無料で再利用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每句一次 AI 请求。已处理过的句子会跳过；别处已精讲过的相同原文会直接复用，不再花钱。"
          }
        }
      }
    },
    "batch.scope.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
