    "settings.data.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone, iPad and Mac sync automatically over iCloud. Use import to bring in material prepared in the desktop app, and export to take your data with you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone・iPad・Mac は iCloud で自動同期されます。読み込みはデスクトップ版で用意した素材を取り込むため、書き出しはデータを持ち出すためのものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad 与 Mac 之间会经 iCloud 自动同步。导入用于把桌面版加工好的素材拿进来，导出用于带走你自己的数据。"
          }
        }
      }
    },
