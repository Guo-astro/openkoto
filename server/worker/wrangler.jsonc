{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openkoto-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "APP_NAME": "OpenKoto",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "OpenKoto <noreply@openkoto.app>",
    "APPLE_APP_BUNDLE_ID": "com.openkoto.ios"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "openkoto", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "openkoto-files" }],
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "UserVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserVault"] }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "openkoto-jobs" }],
    "consumers": [{ "queue": "openkoto-jobs", "max_batch_size": 5, "max_retries": 3 }]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": { "directory": "../../apps/web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*", "/.well-known/*", "/mcp", "/mcp/*"] }
}
